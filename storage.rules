rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/body_photos/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/meal_photos/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
